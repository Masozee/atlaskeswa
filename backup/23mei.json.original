DQ15", "question_text": "SEBERAPA INTENSIF ODGJ MENGIKUTI KEGIATAN LAYANAN JARINGAN PERTEMANAN, PEMBERIAN NASIHAT, DAN/ATAU DUKUNGAN BAGI ODGJ/KELUARGA TERSEBUT?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 45, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BAIK, KARENA BAPAK/IBU TADI MENYAMPAIKAN BAHWA FASILITAS INI MENYEDIAKAN JARINGAN PERTEMANAN, PEMBERIAN NASIHAT, DAN/ATAU DUKUNGAN BAGI ODGJ/KELUARGA, SELANJUTNYA SAYA AKAN MENANYAKAN TERKAIT INTENSITAS LAYANAN TERSEBUT.", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.316Z", "updated_at": "2026-05-07T04:55:09.629Z"}}, {"model": "survey.question", "pk": 94, "fields": {"section": 3, "code": "OQ1", "question_text": "BAGAIMANA KONDISI ODGJ YANG DITERIMA DI LAYANAN RAWAT JALAN DI FASILITAS INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 46, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "SAYA AKAN MENANYAKAN BEBERAPA HAL TERKAIT DENGAN LAYANAN RAWAT JALAN KARENA BAPAK/IBU TADI MENJAWAB BAHWA FASILITAS INI MEMILIKI LAYANAN RAWAT JALAN.\n\nLAYANAN RAWAT JALAN ADALAH LAYANAN YANG MEMBERIKAN PENANGANAN KONDISI KESEHATAN BAGI ODGJ, BAIK ODGJ BARU MAUPUN LAMA, DI MANA SETELAH SELESAI, ODGJ DIPERBOLEHKAN PULANG DI HARI YANG SAMA (TANPA MENGINAP).", "keterangan": "JAWABAN BOLEH LEBIH DARI SATU", "validation_rules": null, "show_condition": {"value": "O", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T07:25:20.382Z", "updated_at": "2026-05-22T12:38:46.413Z"}}, {"model": "survey.question", "pk": 95, "fields": {"section": 3, "code": "OQ2", "question_text": "BAGAIMANA LAYANAN RAWAT JALAN INI DIBERIKAN?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 47, "mtc_code": null, "desde_ltc_description": "", "introd