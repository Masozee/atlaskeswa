-05-09T04:49:17.420Z"}}, {"model": "survey.question", "pk": 351, "fields": {"section": 5, "code": "SOQE", "question_text": "BERAPA RATA-RATA WAKTU YANG DIBUTUHKAN UNTUK MELAYANI SETIAP ODGJ?", "answer_type": "NUMBER", "is_required": true, "order": 217, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Waktu yang dibutuhkan oleh ODGJ untuk mengakses layanan, mulai dari pendaftaran (datang) sampai selesai rawat jalan (pulang), tulis dalam satuan jam.", "validation_rules": null, "show_condition": {"value": "SO", "operator": "contains", "question_code": "QL2"}, "skip_logic": [{"goto": "SOQF", "value": "_next"}], "table_config": null, "created_at": "2026-04-15T08:30:21.836Z", "updated_at": "2026-05-09T04:49:34.920Z"}}, {"model": "survey.question", "pk": 352, "fields": {"section": 5, "code": "SIQC", "question_text": "APA NAMA SOSIAL MEDIA YANG DIMILIKI LAYANAN INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 236, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "SI", "operator": "contains", "question_code": "QL2"}, "skip_logic": [{"goto": "SIQG", "value": "_next"}], "table_config": null, "created_at": "2026-04-15T08:35:14.690Z", "updated_at": "2026-05-22T13:17:38.693Z"}}, {"model": "survey.question", "pk": 353, "fields": {"section": 5, "code": "SIQD", "question_text": "APAKAH FASILITAS INI MENYEDIAKAN LAYANAN KONSULTASI UNTUK RENCANA PERAWATAN (TERMASUK ASESMEN) BERBAYAR?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 237, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "SI", "operator": "contains", "question_code": "QL2"}, "skip_logic": null, "table_config": null, "created_at": "2026-04-15T08:57:36.902Z", "updated_at": "2026-05-22T13:18:21.390Z"}}, {"model": "survey.question", "pk": 354, "fields": {"section":