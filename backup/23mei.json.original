_at": "2026-03-13T06:00:08.303Z", "updated_at": "2026-05-22T12:37:14.615Z"}}, {"model": "survey.question", "pk": 72, "fields": {"section": 3, "code": "DQ6", "question_text": "SEBERAPA INTENSIF ODGJ BEKERJA DENGAN MENERIMA GAJI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 36, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BAIK, KARENA BAPAK/IBU TADI MENYAMPAIKAN BAHWA FASILITAS INI MEMBERI KESEMPATAN BAGI ODGJ UNTUK BEKERJA DAN DIGAJI, \nSELANJUTNYA SAYA AKAN MENANYAKAN TERKAIT INTENSITAS KEHADIRAN ODGJ DALAM LAYANAN TERSEBUT.", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.304Z", "updated_at": "2026-05-22T12:37:34.156Z"}}, {"model": "survey.question", "pk": 73, "fields": {"section": 3, "code": "DQ7", "question_text": "BAGAIMANA KETENTUAN KERJA YANG DIBERLAKUKAN?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 37, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.305Z", "updated_at": "2026-05-03T13:09:00.203Z"}}, {"model": "survey.question", "pk": 74, "fields": {"section": 3, "code": "DQ8", "question_text": "BAGAIMANA KETENTUAN KERJA YANG DIBERLAKUKAN?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 38, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.307Z", "updated_at": "2026-05-03T13:09:19.443Z"}}, {"model": "survey.question", "pk": 75, "fields": {"section": 3, "code": "DQ9", "question_text": "SEBERAPA INTENSIF ODGJ YANG BEKERJA TANPA DIBERI GAJI ATAU MEMPEROLEH GAJI KURANG DARI 50%?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 39, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BAIK, KARENA BAPAK/IBU TADI MENYAMPAIKAN BAHWA FASILITAS INI MEMBERI KESEMPATAN BAGI ODGJ UNTUK BEKERJA TANPA DIBERI GAJI ATAU MEMPEROLEH GAJI KURANG DARI 50%, \nSELANJUTNYA SAYA AKAN MENANYAKAN TERKAIT INTENSITAS LAYANAN TERSEBUT.", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.308Z", "updated_at": "2026-05-07T04:51:48.839Z"}}, {"model": "survey.question", "pk": 76, "fields": {"section": 3, "code": "DQ10", "question_text": "APAKAH ADA KETENTUAN BATASAN WAKTU BAGI ODGJ DALAM MENGIKUTI PROGRAM TERSEBUT?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 40, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.309Z", "updated_at": "2026-05-08T16:06:55.603Z"}}, {"model": "survey.question", "pk": 77, "fields": {"section": 3, "code": "DQ11", "question_text": "APAKAH ADA KETENTUAN BATASAN WAKTU BAGI ODGJ DALAM MENGIKUTI PROGRAM TERSEBUT?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 41, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "D", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T06:00:08.311Z", "updated_at": "2026-05-08T16:07:45.303Z"}}, {"model": "survey.question", "pk": 78, "fields": {"section": 3, "code": "DQ12", "question_text": "SEBERAPA INTENSIF ODGJ MENGIKUTI PELATIHAN K