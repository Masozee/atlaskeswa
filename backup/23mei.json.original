tive": true}}, {"model": "survey.geographicunit", "pk": 1002, "fields": {"code": "3305142018", "name": "Penusupan", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1840389", "longitude": "110.1402816", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1003, "fields": {"code": "3305142008", "name": "Purwodeso", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1844464", "longitude": "109.6906870", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1004, "fields": {"code": "3305142017", "name": "Sidoagung", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1848539", "longitude": "110.1402817", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1005, "fields": {"code": "3305142003", "name": "Sidoarjo", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1852614", "longitude": "109.6906871", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1006, "fields": {"code": "3305142006", "name": "Sruweng", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1856689", "longitude": "110.1402818", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1007, "fields": {"code": "3305142010", "name": "Tanggeran", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1860764", "longitude": "109.6906872", "is_active": true}}, {"model": "survey.geographicunit", "pk": 1008, "fields": {"code": "3305142002", "name": "Trikarso", "level": "DESA_KELURAHAN", "parent": 548, "latitude": "-7.1864839", "longitude": "110.1402819", "is_active": true}}, {"model": "survey.surveytemplate", "pk": 1, "fields": {"name": "Kuesioner OMMHA (One Map for Mental Health Atlas)", "code": "OMMHA_V1", "description": "Adaptasi Description and Evaluation of Services and Directories in Europe for Long Term Care (DESDE-LTC) untuk pemetaan layanan kesehatan jiwa di Indonesia.", "version": "1.0", "target_mtc": null, "template_type": "GENERAL", "is_active": true, "created_by": null, "created_at": "2026-02-05T13:54:30.939Z", "updated_at": "2026-02-06T06:17:19.713Z"}}, {"model": "survey.questionsection", "pk": 1, "fields": {"template": 1, "code": "DATA_DASAR", "name": "Data Dasar", "description": "Informasi dasar tentang fasilitas layanan", "order": 1, "introduction_text": "Perkenalkan, saya (nama enumerator) dari Tim Penelitian OMMHA Pusat Rehabilitasi Yakkum.\r\n\r\nSaat ini, kami sedang melakukan pendataan dan pemetaan layanan kesehatan jiwa menggunakan kerangka DESDE-LTC (Description and Evaluation of Services and Directories for Long-Term Care).\r\n\r\nWawancara ini bertujuan untuk mengidentifikasi jenis layanan kesehatan jiwa yang diselenggarakan oleh fasilitas ini berdasarkan praktik yang dilakukan.\r\n\r\nSeluruh informasi yang diberikan akan dijaga kerahasiaannya dan digunakan hanya untuk kepentingan penelitian.", "show_condition": null}}, {"model": "survey.questionsection", "pk": 2, "fields": {"template": 1, "code": "JENIS_LAYANAN", "name": "Jenis Layanan", "description": "Pertanyaan untuk mengklasifikasi layanan rawat inap (Kode R)", "order": 2, "introduction_text": "", "show_condition": null}}, {"model": "survey.questionsection", "pk": 3, "fields": {"template": 1, "code": "FASKSES", "name": "Fasilitas Kesehatan", "description": "Informasi detail tentang layanan rawat inap yang diberikan", "order": 3, "introduction_text": "", "show_condition": {"value": ["RSU", "RSJ", "PUSKESMAS", "KLINIK", "PRAKTEK_DOKTER"], "operator": "in", "question_code": "Q4"}}}, {"model": "survey.questionsection", "pk": 4, "fields": {"template": 1, "code": "NON-FASKES", "name": "Fasilitas Non Kesehatan", "description": "Pertanyaan untuk menentukan jenis layanan yang diberikan fasilitas", "order": 4, "introduction_text": "", "show_condition": {"value": ["BALAI_REHABILITASI", "PANTI_SOSIAL", "OBK", "LSM", "LKS", "PRAKTIK_PRIBADI", "LAINNYA"], "operator": "in", "question_code": "Q4"}}}, {"model": "survey.questionsection", "pk": 5, "fields": {"template": 1, "code": "DETAIL", "name": "Pertanyaan Detail", "description": "", "order": 5, "introduction_text": "", "show_condition": {"question_code": "_inline_only_"}}}, {"model": "survey.question", "pk": 1, "fields": {"section": 1, "code": "Q1", "question_text": "APA NAMA RESMI FASILITAS INI SEPERTI YANG TERCANTUM DALAM DOKUMEN LEGAL LEMBAGA?", "answer_type": "TEXT", "is_required": true, "order": 1, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Nama fasilitas layanan adalah nama resmi fasilitas sebagaimana tercantum dalam dokumen legal atau administratif (misalnya surat keputusan pendirian, izin operasional, akreditasi, atau papan nama resmi fasilitas).\n\nJika fasilitas lebih dikenal dengan nama lain (nama populer/singkatan), maka:\n- nama resmi tetap dicatat sebagai jawaban utama, dan\n- nama populer/singkatan dapat dicantumkan.", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q2", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.942Z", "updated_at": "2026-05-04T03:04:09.266Z"}}, {"model": "survey.question", "pk": 2, "fields": {"section": 1, "code": "Q2", "question_text": "APAKAH FASILITAS INI PERNAH MEMBERIKAN LAYANAN KEPADA ORANG DENGAN GANGGUAN JIWA (ODGJ)?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 2, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q3", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.944Z", "updated_at": "2026-05-22T12:23:29.856Z"}}, {"model": "survey.question", "pk": 3, "fields": {"section": 1, "code": "Q3", "question_text": "APA BIDANG UTAMA DARI LAYANAN YANG DIBERIKAN OLEH FASILITAS INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 3, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Sektor Kesehatan: Lembaga yang fungsi utamanya memberikan pelayanan kesehatan, baik promotif, preventif, kuratif, maupun rehabilitatif, termasuk layanan kesehatan jiwa.\n\nSektor Sosial: Lembaga yang fungsi utamanya berada dalam sistem kesejahteraan sosial, termasuk perlindungan, rehabilitasi sosial, pemberdayaan, dan dukungan sosial bagi individu atau kelompok rentan.\n\nSektor Pendidikan: Lembaga yang fungsi utamanya menyediakan layanan pendidikan atau pelatihan, baik formal maupun non-formal.\n\nSektor Ketenagakerjaan: Lembaga yang fungsi utamanya berkaitan dengan pelatihan kerja, rehabilitasi berbasis kerja, atau penempatan kerja.\n\nSektor Hukum/Peradilan: Lembaga yang berada dalam sistem penegakan hukum atau peradilan, termasuk pemasyarakatan.\n\nSektor Keagamaan: Lembaga yang berbasis nilai-nilai keagamaan, dan menyediakan layanan dukungan, rehabilitasi, konseling, atau perawatan yang terintegrasi dengan pendekatan keagamaan.", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q4", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.946Z", "updated_at": "2026-05-22T12:24:44.242Z"}}, {"model": "survey.question", "pk": 4, "fields": {"section": 1, "code": "Q4", "question_text": "APA BENTUK KELEMBAGAAN FASILITAS INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 4, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Jenis fasilitas layanan mengacu pada bentuk dan struktur fisik/kelembagaan fasilitas, bukan jenis layanan yang diberikan.\n\nRumah Sakit Umum: Fasilitas pelayanan kesehatan rujukan yang menyediakan pelayanan medis rawat jalan dan/atau rawat inap untuk berbagai kondisi kesehatan, termasuk layanan kesehatan jiwa.\n\nRumah Sakit Jiwa: Fasilitas pelayanan kesehatan khusus yang fokus utama pelayanannya adalah kesehatan jiwa.\n\nPuskesmas: Fasilitas pelayanan kesehatan tingkat pertama yang menyelenggarakan pelayanan kesehatan dasar, termasuk layanan kesehatan jiwa.\n\nKlinik: Fasilitas pelayanan kesehatan non-rumah sakit yang memberikan pelayanan medis rawat jalan.\n\nBalai atau Unit Rehabilitasi: Fasilitas yang fungsi utamanya adalah rehabilitasi, baik rehabilitasi kesehatan jiwa, rehabilitasi sosial, atau rehabilitasi berbasis kerja/keterampilan.\n\nPanti Sosial/Lembaga Rehabilitasi Sosial: Fasilitas yang menyediakan layanan perawatan, perlindungan, dan/atau rehabilitasi sosial.\n\nOrganisasi Berbasis Komunitas: Fasilitas yang dikelola oleh komunitas, kelompok swadaya, atau organisasi masyarakat.\n\nLembaga Swadaya Masyarakat: Fasilitas atau layanan yang dikelola oleh organisasi non-pemerintah dan non-profit.\n\nPraktik Pribadi (Mandiri): Layanan yang dikelola secara perorangan dan memberikan layanan secara mandiri.", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q5", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.952Z", "updated_at": "2026-05-22T12:27:40.447Z"}}, {"model": "survey.question", "pk": 5, "fields": {"section": 1, "code": "Q5", "question_text": "PROVINSI", "answer_type": "GEO_PROVINSI", "is_required": true, "order": 5, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Pilih provinsi lokasi fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q6", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.961Z", "updated_at": "2026-04-22T07:32:17.679Z"}}, {"model": "survey.question", "pk": 6, "fields": {"section": 1, "code": "Q6", "question_text": "KABUPATEN/KOTA", "answer_type": "GEO_KABUPATEN", "is_required": true, "order": 6, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Pilih kabupaten/kota lokasi fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q7", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.961Z", "updated_at": "2026-04-22T07:32:17.687Z"}}, {"model": "survey.question", "pk": 7, "fields": {"section": 1, "code": "Q7", "question_text": "KECAMATAN", "answer_type": "GEO_KECAMATAN", "is_required": true, "order": 7, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Pilih kecamatan lokasi fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q8", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.962Z", "updated_at": "2026-04-22T07:32:17.693Z"}}, {"model": "survey.question", "pk": 8, "fields": {"section": 1, "code": "Q8", "question_text": "DESA", "answer_type": "GEO_DESA", "is_required": true, "order": 8, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Pilih desa/kelurahan lokasi fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q9", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.963Z", "updated_at": "2026-04-22T07:32:17.703Z"}}, {"model": "survey.question", "pk": 9, "fields": {"section": 1, "code": "Q9", "question_text": "ALAMAT", "answer_type": "TEXTAREA", "is_required": true, "order": 9, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Alamat lengkap fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q10", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.963Z", "updated_at": "2026-04-22T07:32:17.709Z"}}, {"model": "survey.question", "pk": 10, "fields": {"section": 1, "code": "Q10", "question_text": "TELEPHONE", "answer_type": "PHONE", "is_required": false, "order": 10, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Nomor telepon fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q11", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.964Z", "updated_at": "2026-04-22T07:32:17.608Z"}}, {"model": "survey.question", "pk": 11, "fields": {"section": 1, "code": "Q11", "question_text": "E-MAIL", "answer_type": "EMAIL", "is_required": false, "order": 11, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Alamat email fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q12", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.964Z", "updated_at": "2026-04-22T14:28:35.595Z"}}, {"model": "survey.question", "pk": 12, "fields": {"section": 1, "code": "Q12", "question_text": "SITUS WEB", "answer_type": "URL", "is_required": false, "order": 12, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Website fasilitas", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q13", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.965Z", "updated_at": "2026-04-22T07:32:17.622Z"}}, {"model": "survey.question", "pk": 13, "fields": {"section": 1, "code": "Q13", "question_text": "APA STATUS BADAN HUKUM FASILITAS INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 13, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Yayasan: Fasilitas dikelola oleh badan hukum yayasan sesuai peraturan perundang-undangan.\nPerkumpulan/Asosiasi: Fasilitas dikelola oleh badan hukum perkumpulan atau asosiasi.\nKoperasi: Fasilitas dikelola oleh badan hukum koperasi.\nPerusahaan Swasta: Fasilitas dikelola oleh badan usaha swasta berbadan hukum (PT, CV, dll).\nBUMN: Fasilitas dikelola oleh badan usaha milik negara.\nBUMD: Fasilitas dikelola oleh badan usaha milik daerah.\nBLUD: Unit layanan Pemerintah Daerah dengan pola BLUD.\nUPTD: Fasilitas merupakan unit pelaksana teknis daerah.\nPraktik Pribadi: Layanan diselenggarakan oleh individu.", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q14", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.966Z", "updated_at": "2026-05-22T12:29:21.746Z"}}, {"model": "survey.question", "pk": 14, "fields": {"section": 1, "code": "Q14", "question_text": "APAKAH FASILITAS INI MEMILIKI DOKUMEN LEGALITAS PENDIRIAN?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 14, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": null, "skip_logic": [{"goto": "Q15", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.973Z", "updated_at": "2026-05-07T03:51:15.517Z"}}, {"model": "survey.question", "pk": 15, "fields": {"section": 1, "code": "Q15", "question_text": "SEJAK KAPAN FASILITAS INI MEMBERIKAN LAYANAN KESEHATAN JIWA?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 15, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "Tahun mulai beroperasi fasilitas", "validation_rules": {"max": 2030, "min": 1900}, "show_condition": null, "skip_logic": [{"goto": "Q16", "value": "_next"}], "table_config": null, "created_at": "2026-02-05T13:54:30.974Z", "updated_at": "2026-05-22T12:29:52.153Z"}}, {"model": "survey.question", "pk": 16, "fields": {"section": 1, "code": "Q16", "question_text": "DI TINGKAT MANA CAKUPAN LAYANAN YANG DISELENGGARAKAN OLEH FASILITAS INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 16, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "(JAWABAN BOLEH LEBIH DARI 1)\n\nWilayah cakupan layanan adalah wilayah geografis utama tempat pengguna layanan berasal atau dilayani secara rutin oleh fasilitas, terlepas dari lokasi fisik fasilitas berada.\n\nPenentuan wilayah cakupan berdasarkan praktik pelayanan sehari-hari, bukan berdasarkan mandat administratif semata atau potensi layanan.\n\n- Desa/Kelurahan: Fasilitas melayani pengguna yang berasal dari satu desa/kelurahan atau beberapa desa/kelurahan di sekitarnya.\n- Kecamatan: Fasilitas melayani pengguna yang berasal dari beberapa desa/kelurahan dalam satu kecamatan.\n- Kabupaten/Kota: Fasilitas melayani pengguna yang berasal dari seluruh atau sebagian besar wilayah kabupaten/kota.\n- Provinsi: Fasilitas melayani pengguna dari lintas kabupaten/kota dalam satu provinsi.\n- Nasional: Fasilitas melayani pengguna dari berbagai provinsi di Indonesia.", "validation_rules": null, "show_condition": null, "skip_logic": null, "table_config": null, "created_at": "2026-02-05T13:54:30.975Z", "updated_at": "2026-05-22T12:30:35.158Z"}}, {"model": "survey.question", "pk": 40, "fields": {"section": 2, "code": "QL1", "question_text": "APA SAJA JENIS-JENIS LAYANAN KESEHATAN JIWA YANG DISEDIAKAN DI FASILITAS INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 17, "mtc_code": null, "desde_ltc_description": "-", "introduction_text": "BERDASARKAN JAWABAN YANG DIBERIKAN PADA PERTANYAAN SEBELUMNYA, BENTUK LEMBAGA BAPAK/IBU MASUK DALAM KATEGORI FASILITAS KESEHATAN. \n\nUNTUK ITU, KAMI AKAN MENANYAKAN BEBERAPA PERTANYAAN LANJUTAN TERKAIT DENGAN JENIS-JENIS LAYANAN YANG DISEDIAKAN OLEH FASILITAS INI.", "keterangan": "JAWABAN BOLEH LEBIH DARI SATU", "validation_rules": null, "show_condition": {"value": ["RSU", "RSJ", "PUSKESMAS", "KLINIK", "PRAKTEK_DOKTER"], "operator": "in", "question_code": "Q4"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-07T18:10:54.093Z", "updated_at": "2026-05-08T15:49:48.578Z"}}, {"model": "survey.question", "pk": 42, "fields": {"section": 2, "code": "QL2", "question_text": "APA SAJA JENIS-JENIS LAYANAN KESEHATAN JIWA YANG DISEDIAKAN DI FASILITAS INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 18, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BERDASARKAN JAWABAN YANG DIBERIKAN PADA PERTANYAAN SEBELUMNYA, BENTUK LEMBAGA BAPAK/IBU MASUK DALAM KATEGORI NON-FASILITAS KESEHATAN. \n\nUNTUK ITU, KAMI AKAN MENANYAKAN BEBERAPA PERTANYAAN LANJUTAN TERKAIT DENGAN JENIS-JENIS LAYANAN YANG DISEDIAKAN OLEH FASILITAS INI.", "keterangan": "JAWABAN BOLEH LEBIH DARI SATU.", "validation_rules": null, "show_condition": {"value": ["BALAI_REHABILITASI", "PANTI_SOSIAL", "OBK", "LSM", "LKS", "PRAKTIK_PRIBADI", "LAINNYA"], "operator": "in", "question_code": "Q4"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T02:18:37.476Z", "updated_at": "2026-05-08T15:52:01.786Z"}}, {"model": "survey.question", "pk": 43, "fields": {"section": 3, "code": "RQ1", "question_text": "BAGAIMANA KONDISI ODGJ YANG DITERIMA DI LAYANAN RAWAT INAP DI FASILITAS INI?", "answer_type": "MULTIPLE_CHOICE", "is_required": true, "order": 19, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "SAYA AKAN MENANYAKAN BEBERAPA HAL TERKAIT DENGAN LAYANAN RAWAT INAP KARENA BAPAK/IBU TADI MENJAWAB BAHWA FASILITAS INI MEMILIKI LAYANAN RAWAT INAP.\n\nLAYANAN RAWAT INAP ADALAH LAYANAN YANG MENYEDIAKAN TEMPAT TIDUR UNTUK RAWAT INAP BAGI ODGJ UNTUK PERAWATAN KESEHATAN JIWANYA.", "keterangan": "JAWABAN BOLEH LEBIH DARI SATU", "validation_rules": null, "show_condition": {"value": "R", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T03:42:51.895Z", "updated_at": "2026-05-22T12:30:59.238Z"}}, {"model": "survey.question", "pk": 44, "fields": {"section": 3, "code": "RQ2", "question_text": "BAGAIMANA KETERSEDIAAN DOKTER JAGA DI LAYANAN RAWAT INAP INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 20, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BEBERAPA PERTANYAAN BERIKUT INI TERKAIT DENGAN LAYANAN RAWAT INAP BAGI ODGJ DENGAN KONDISI AKUT. \nMOHON BAPAK/IBU DAPAT MEMBERIKAN JAWABAN SESUAI DENGAN KONDISI YANG ADA DI FASILITAS INI.", "keterangan": "", "validation_rules": null, "show_condition": {"value": "R", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T04:21:22.230Z", "updated_at": "2026-05-22T12:31:33.204Z"}}, {"model": "survey.question", "pk": 45, "fields": {"section": 3, "code": "RQ3", "question_text": "BAGAIMANA PEMANTAUAN BAGI ODGJ AKUT YANG MENJALANI RAWAT INAP?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 21, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "R", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T04:39:55.866Z", "updated_at": "2026-05-22T12:32:12.164Z"}}, {"model": "survey.question", "pk": 46, "fields": {"section": 3, "code": "RQ4", "question_text": "APA LAYANAN UTAMA YANG DIBERIKAN KEPADA ODGJ AKUT SELAMA MENJALANI RAWAT INAP?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 22, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "", "keterangan": "", "validation_rules": null, "show_condition": {"value": "R", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T04:39:55.867Z", "updated_at": "2026-05-22T12:33:34.037Z"}}, {"model": "survey.question", "pk": 47, "fields": {"section": 3, "code": "RQ5", "question_text": "BAGAIMANA KARAKTERISTIK LAYANAN RAWAT INAP BAGI ODGJ NON-AKUT DI FASILITAS INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order": 23, "mtc_code": null, "desde_ltc_description": "", "introduction_text": "BEBERAPA PERTANYAAN BERIKUT INI TERKAIT DENGAN LAYANAN RAWAT INAP BAGI ODGJ NON AKUT. \nMOHON BAPAK/IBU DAPAT MEMBERIKAN JAWABAN SESUAI DENGAN KONDISI YANG ADA DI FASILITAS INI.", "keterangan": "", "validation_rules": null, "show_condition": {"value": "R", "operator": "contains", "question_code": "QL1"}, "skip_logic": null, "table_config": null, "created_at": "2026-03-13T04:39:55.868Z", "updated_at": "2026-05-22T12:32:49.873Z"}}, {"model": "survey.question", "pk": 48, "fields": {"section": 3, "code": "RQ6", "question_text": "APAKAH ADA KETENTUAN BATASAN WAKTU TINGGAL DI LAYANAN RAWAT INAP INI?", "answer_type": "SINGLE_CHOICE", "is_required": true, "order"