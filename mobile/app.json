{
  "expo": {
    "name": "OMMHA",
    "slug": "yakkum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to record your position.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to record your position even in the background.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload facility photos."
      },
      "bundleIdentifier": "id.atlaskeswa.mobile"
    },
    "android": {
      "package": "id.atlaskeswa.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow OMMHA to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photo library to upload facility photos."
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "659ec737-e29c-4538-842a-40319375f01b"
      }
    },
    "owner": "kapulaga"
  }
}
